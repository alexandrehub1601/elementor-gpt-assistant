# --- Ticketmaster (via oficial, recomendada) ---
# Chave grátis em https://developer.ticketmaster.com (app "Discovery API")
TICKETMASTER_API_KEY=

# --- E-mail ---
# smtp (padrão) ou resend
MAIL_TRANSPORT=smtp
MAIL_FROM="Alerta de Ingressos <seu-email@gmail.com>"

# Gmail: use uma SENHA DE APP (não a senha da conta) -> myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=

# Alternativa sem SMTP (boa para serverless):
# MAIL_TRANSPORT=resend
# RESEND_API_KEY=

# --- Opcionais ---
TZ=America/Sao_Paulo
# DRY_RUN=1            # imprime o e-mail no console em vez de enviar
# TICKETS_PAGE_PROBE=0 # desliga a leitura da página pública (fica só a API oficial)
